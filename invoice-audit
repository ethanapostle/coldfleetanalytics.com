<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ColdFleet · Invoice Audit</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0d1418; --panel:#141d23; --panel-2:#1a242b; --line:#26333b;
    --line-soft:#1f2a31;
    --txt:#e7eef2; --txt-2:#94a8b2; --txt-3:#5f7480;
    --cyan:#37d2c4; --cyan-dim:#1f9b90;
    --green:#56d189; --amber:#e9a93f; --red:#e85a50;
    --mono:'IBM Plex Mono',monospace; --sans:'IBM Plex Sans',sans-serif; --disp:'Archivo',sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--txt);font-family:var(--sans);font-size:14px;line-height:1.5;
    background-image:radial-gradient(circle at 15% -10%, rgba(55,210,196,.07), transparent 45%);
    min-height:100vh;-webkit-font-smoothing:antialiased}
  .wrap{max-width:1120px;margin:0 auto;padding:28px 22px 80px}

  /* header */
  header{display:flex;align-items:flex-end;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:18px;margin-bottom:26px;flex-wrap:wrap;gap:14px}
  .brand{display:flex;align-items:center;gap:11px}
  .logo{width:34px;height:34px;border-radius:8px;background:linear-gradient(140deg,var(--cyan),var(--cyan-dim));display:grid;place-items:center;font-family:var(--disp);font-weight:800;color:#06181a;font-size:18px}
  .brand h1{font-family:var(--disp);font-weight:800;letter-spacing:-.02em;font-size:21px}
  .brand .sub{font-family:var(--mono);font-size:11px;color:var(--txt-3);letter-spacing:.04em;text-transform:uppercase}
  .tagline{text-align:right;max-width:320px}
  .tagline b{font-family:var(--disp);font-size:15px;font-weight:700;color:var(--cyan)}
  .tagline span{display:block;font-size:12px;color:var(--txt-2)}

  /* layout */
  .grid{display:grid;grid-template-columns:1fr;gap:18px}
  .panel{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px}
  .panel h2{font-family:var(--disp);font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--txt-2);margin-bottom:14px;display:flex;align-items:center;gap:8px}
  .panel h2 .num{font-family:var(--mono);font-size:11px;color:#06181a;background:var(--cyan);border-radius:5px;padding:1px 7px;font-weight:600}

  /* input zone */
  .drop{border:1.5px dashed var(--line);border-radius:12px;padding:26px;text-align:center;cursor:pointer;transition:.18s;background:var(--panel-2)}
  .drop:hover,.drop.over{border-color:var(--cyan);background:rgba(55,210,196,.05)}
  .drop .ic{font-size:26px;margin-bottom:6px;opacity:.8}
  .drop b{color:var(--txt)}
  .drop small{display:block;color:var(--txt-3);margin-top:4px;font-size:12px}
  textarea{width:100%;margin-top:14px;background:var(--panel-2);border:1px solid var(--line);border-radius:10px;color:var(--txt);font-family:var(--mono);font-size:12.5px;padding:13px;min-height:118px;resize:vertical}
  textarea:focus{outline:none;border-color:var(--cyan-dim)}
  .row{display:flex;gap:12px;flex-wrap:wrap;margin-top:14px;align-items:flex-end}
  .field{flex:1;min-width:150px}
  .field label{display:block;font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--txt-3);margin-bottom:5px;font-weight:500}
  select,input.txt{width:100%;background:var(--panel-2);border:1px solid var(--line);border-radius:9px;color:var(--txt);padding:10px 11px;font-family:var(--sans);font-size:13.5px}
  select:focus,input.txt:focus{outline:none;border-color:var(--cyan-dim)}
  .btn{background:var(--cyan);color:#06181a;border:none;border-radius:9px;padding:11px 22px;font-family:var(--disp);font-weight:700;font-size:13.5px;cursor:pointer;letter-spacing:.02em;transition:.15s}
  .btn:hover{filter:brightness(1.08)}
  .btn.ghost{background:transparent;color:var(--txt-2);border:1px solid var(--line)}

  /* results */
  #results{display:none;animation:fade .4s ease}
  @keyframes fade{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

  /* table */
  table{width:100%;border-collapse:collapse;font-size:13px}
  th{text-align:left;font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;color:var(--txt-3);font-weight:600;padding:8px 10px;border-bottom:1px solid var(--line)}
  td{padding:9px 10px;border-bottom:1px solid var(--line-soft);vertical-align:middle}
  tr:last-child td{border-bottom:none}
  .code{font-family:var(--mono);font-size:11.5px;color:var(--cyan);background:rgba(55,210,196,.1);padding:2px 7px;border-radius:5px}
  .code.nomatch{color:var(--amber);background:rgba(233,169,63,.12)}
  td.n{text-align:right;font-family:var(--mono)}
  input.hr{width:62px;background:var(--panel-2);border:1px solid var(--line);border-radius:6px;color:var(--txt);padding:5px 7px;font-family:var(--mono);font-size:12px;text-align:right}
  input.hr:focus{outline:none;border-color:var(--cyan)}
  input.hr.flag{border-color:var(--amber)}
  tfoot td{border-top:1px solid var(--line);padding-top:11px;font-weight:600}

  /* gauges */
  .gauges{display:grid;grid-template-columns:1fr 1fr;gap:18px}
  .gauge-card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:20px 20px 16px}
  .gauge-card h3{font-family:var(--disp);font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;margin-bottom:2px}
  .gauge-card .hint{font-size:11.5px;color:var(--txt-3);margin-bottom:6px}
  .gsvg{width:100%;display:block;touch-action:none}
  .gsvg .needle{cursor:grab}
  .gsvg.drag .needle{cursor:grabbing}
  .verdict{display:flex;align-items:baseline;justify-content:space-between;margin-top:6px}
  .verdict .val{font-family:var(--mono);font-size:30px;font-weight:600;line-height:1}
  .verdict .vu{font-size:12px;color:var(--txt-2);font-weight:500;margin-left:6px}
  .verdict .tag{font-family:var(--disp);font-weight:700;font-size:13px;text-transform:uppercase;letter-spacing:.05em;padding:4px 11px;border-radius:20px}
  .gnote{font-size:11.5px;color:var(--txt-2);margin-top:10px;border-top:1px solid var(--line-soft);padding-top:9px}
  .gnote b{color:var(--txt);font-family:var(--mono)}

  /* summary cards */
  .summary{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:4px}
  .scard{background:var(--panel-2);border:1px solid var(--line);border-radius:11px;padding:13px 14px}
  .scard .lab{font-size:10.5px;text-transform:uppercase;letter-spacing:.05em;color:var(--txt-3);margin-bottom:5px}
  .scard .v{font-family:var(--mono);font-size:19px;font-weight:600}
  .scard.big .v{font-size:22px}
  .v.pos{color:var(--green)} .v.neg{color:var(--red)}

  .verdict-banner{display:flex;align-items:center;gap:13px;background:var(--panel-2);border:1px solid var(--line);border-left-width:4px;border-radius:11px;padding:15px 17px;margin-bottom:4px}
  .verdict-banner .em{font-size:24px}
  .verdict-banner b{font-family:var(--disp);font-size:16px;font-weight:700}
  .verdict-banner p{font-size:13px;color:var(--txt-2);margin-top:2px}

  .placeholder-note{font-size:11.5px;color:var(--amber);background:rgba(233,169,63,.08);border:1px solid rgba(233,169,63,.25);border-radius:8px;padding:9px 12px;margin-top:12px}
  .placeholder-note b{color:var(--txt);font-family:var(--mono)}

  /* warranty kpi */
  .wbadge{text-align:center;padding:11px 18px;border-radius:12px;min-width:148px;border:1px solid var(--line)}
  .wbadge .st{font-family:var(--disp);font-weight:800;font-size:16px;text-transform:uppercase;letter-spacing:.02em}
  .wbadge .sub{font-size:11px;color:var(--txt-2);margin-top:3px;font-family:var(--mono)}
  .wmsg{font-size:13px;border-radius:9px;padding:11px 13px;display:flex;gap:9px;align-items:flex-start}
  .wmsg .i{font-size:16px;line-height:1.3}
  .wmsg.flag{background:rgba(232,90,80,.1);border:1px solid rgba(232,90,80,.3)}
  .wmsg.conc{background:rgba(233,169,63,.1);border:1px solid rgba(233,169,63,.3)}
  .wmsg.ok{background:rgba(86,209,137,.07);border:1px solid rgba(86,209,137,.22)}
  .wmsg b{color:var(--txt)}

  /* savings */
  .savings-head{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:13px}
  .savings-head .tot{font-family:var(--mono);font-size:19px;color:var(--green);font-weight:600}
  .sopp{display:flex;align-items:center;gap:14px;background:var(--panel-2);border:1px solid var(--line);border-left:3px solid var(--green);border-radius:11px;padding:13px 15px}
  .sopp+.sopp{margin-top:10px}
  .sopp .body{flex:1;min-width:0}
  .sopp .body b{font-size:13.5px}
  .sopp .body p{font-size:12px;color:var(--txt-2);margin-top:2px}
  .sopp .save{font-family:var(--mono);font-weight:600;color:var(--green);font-size:15px;white-space:nowrap}
  .sopp a{color:var(--cyan);text-decoration:none;font-size:12px;font-weight:600;border:1px solid var(--cyan-dim);padding:7px 12px;border-radius:8px;white-space:nowrap}
  .sopp a:hover{background:rgba(55,210,196,.1)}
  @media(max-width:640px){.sopp{flex-wrap:wrap}}

  /* chat */
  .chat-log{display:flex;flex-direction:column;gap:10px;max-height:340px;overflow-y:auto;margin-bottom:13px;padding-right:4px}
  .chat-log:empty{display:none}
  .cmsg{padding:10px 13px;border-radius:12px;font-size:13px;line-height:1.55;max-width:88%;white-space:pre-wrap}
  .cmsg.user{align-self:flex-end;background:var(--cyan);color:#06181a;font-weight:500}
  .cmsg.bot{align-self:flex-start;background:var(--panel-2);border:1px solid var(--line)}
  .cmsg.bot.think{color:var(--txt-3);font-style:italic}
  .chat-input{display:flex;gap:10px}
  .chat-input .txt{flex:1}
  .chat-seed{font-size:12px;color:var(--txt-3);margin-bottom:11px}
  .chat-seed b{color:var(--cyan);cursor:pointer;font-weight:500}
  .chat-seed b:hover{text-decoration:underline}
  @media(max-width:720px){.gauges{grid-template-columns:1fr}.summary{grid-template-columns:1fr 1fr}}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <div class="brand">
      <div class="logo">CF</div>
      <div>
        <h1>Invoice Audit</h1>
        <div class="sub">ColdFleet Analytics · SRT 62-10069 Rev B</div>
      </div>
    </div>
    <div class="tagline">
      <b>Audit your service provider.</b>
      <span>Match every line to the factory SRT, then grade the labor and parts you were charged.</span>
    </div>
  </header>

  <div class="grid">
    <!-- STEP 1: INPUT -->
    <div class="panel">
      <h2><span class="num">1</span> Drop the invoice or describe the job</h2>
      <div class="drop" id="drop">
        <div class="ic">📄</div>
        <b>Drag an invoice here</b> or click to browse
        <small>PDF, image, or paste the line items below</small>
        <input type="file" id="file" hidden>
      </div>
      <textarea id="jobtext" placeholder="Or type / paste the work performed, e.g.&#10;&#10;Unit: Carrier Vector 8600&#10;1. Compressor R&R ............ 6.5 hrs labor  /  $2,480 parts&#10;2. Evacuate & charge system .. 1.5 hrs labor&#10;3. Filter drier R&R .......... 0.5 hrs labor /  $92 parts&#10;4. Condenser motor R&R ....... 1.2 hrs labor /  $315 parts"></textarea>
      <div class="row">
        <div class="field">
          <label>Unit family</label>
          <select id="unit">
            <option value="vector">Carrier Vector / Vector MT</option>
            <option value="x4">Carrier X4 7300 / 7500</option>
            <option value="x2">Carrier X2 2100 / 2500 APX</option>
          </select>
        </div>
        <div class="field">
          <label>Labor rate (/hr)</label>
          <input class="txt" id="rate" type="number" value="165">
        </div>
        <div class="field" style="flex:0 0 auto">
          <label>Invoice currency</label>
          <select id="cur" style="width:118px"><option value="USD">USD</option><option value="CAD">CAD</option></select>
        </div>
        <div class="field" id="fxfield" style="flex:0 0 auto;display:none">
          <label>USD→CAD</label>
          <input class="txt" id="fx" type="number" step="0.01" value="1.37" style="width:92px">
        </div>
        <div class="field" style="flex:0 0 auto">
          <button class="btn" id="analyze">Analyze invoice →</button>
        </div>
      </div>
    </div>

    <!-- RESULTS -->
    <div id="results">

      <!-- verdict banner -->
      <div class="verdict-banner" id="banner" style="margin-bottom:18px">
        <span class="em">✅</span>
        <div><b id="banner-h">Fairly priced</b><p id="banner-p"></p></div>
      </div>

      <!-- WARRANTY KPI -->
      <div class="panel" style="margin-bottom:18px">
        <h2><span class="num">W</span> Warranty &amp; concession check</h2>
        <div style="display:flex;gap:18px;align-items:flex-end;flex-wrap:wrap;margin-bottom:14px">
          <div class="field" style="flex:0 0 auto">
            <label>Unit hours (at repair)</label>
            <input class="txt" id="uhours" type="number" value="6250" style="width:130px">
          </div>
          <div class="field" style="flex:0 0 auto">
            <label>In-service date</label>
            <input class="txt" id="isdate" type="date" value="2024-10-01" style="width:160px">
          </div>
          <div class="wbadge" id="wbadge" style="margin-left:auto">
            <div class="st" id="wst">—</div><div class="sub" id="wsub"></div>
          </div>
        </div>
        <div id="wmsgs"></div>
      </div>

      <!-- STEP 2: SRT breakdown -->
      <div class="panel" style="margin-bottom:18px">
        <h2><span class="num">2</span> SRT breakdown &amp; labor cost</h2>
        <table id="srt-table">
          <thead><tr>
            <th>Line item</th><th>Job code</th>
            <th class="n">SRT hrs</th><th class="n">Billed hrs</th><th class="n">SRT labor</th>
          </tr></thead>
          <tbody id="srt-body"></tbody>
          <tfoot><tr>
            <td>Totals</td><td></td>
            <td class="n" id="t-srt">0.0</td>
            <td class="n" id="t-billed">0.0</td>
            <td class="n" id="t-srtcost">$0</td>
          </tr></tfoot>
        </table>
        <p style="font-size:11.5px;color:var(--txt-3);margin-top:10px">
          Billed hours are read from the invoice when present. Blank or highlighted fields are editable — enter the hours from your invoice to grade them.
        </p>
      </div>

      <!-- STEP 3: gauges -->
      <div class="gauges" style="margin-bottom:18px">
        <!-- LABOR gauge -->
        <div class="gauge-card">
          <h3>Labor correction factor</h3>
          <div class="hint">Billed hours ÷ SRT hours. Drag the needle to set your fair benchmark.</div>
          <svg class="gsvg" id="g-labor" viewBox="0 0 260 168"></svg>
          <div class="verdict">
            <span><span class="val" id="labor-val">1.46</span><span class="vu">× Standard Repair Time</span></span>
            <span class="tag" id="labor-tag">Standard</span>
          </div>
          <div class="gnote">
            This invoice's actual factor: <b id="labor-actual">1.42</b> &nbsp;·&nbsp;
            Fair labor at <b id="labor-factor-echo">1.40×</b>: <b id="labor-fair">$0</b>
          </div>
        </div>
        <!-- PARTS gauge -->
        <div class="gauge-card">
          <h3>Parts pricing</h3>
          <div class="hint">Charged price ÷ manufacturer list. Computed from the parts on the invoice.</div>
          <svg class="gsvg" id="g-parts" viewBox="0 0 260 168"></svg>
          <div class="verdict">
            <span><span class="val" id="parts-val">1.18</span><span class="vu">× OEM List Price</span></span>
            <span class="tag" id="parts-tag">Great</span>
          </div>
          <div class="gnote">
            Charged: <b id="parts-charged">$0</b> &nbsp;·&nbsp; List: <b id="parts-list">$0</b>
            &nbsp;·&nbsp; Over list: <b id="parts-over">$0</b>
          </div>
        </div>
      </div>

      <!-- COST SAVINGS (AVRO) -->
      <div class="panel" id="savings-panel" style="margin-bottom:18px;display:none">
        <div class="savings-head">
          <h2 style="margin:0"><span class="num">$</span> Cost-saving opportunities</h2>
          <span class="tot" id="savings-tot">$0</span>
        </div>
        <div id="savings-list"></div>
        <p style="font-size:11.5px;color:var(--txt-3);margin-top:10px">Aftermarket equivalents sourced from avroparts.com. The live tool checks AVRO stock and pricing in real time.</p>
      </div>

      <!-- STEP 4: summary -->
      <div class="panel">
        <h2><span class="num">3</span> Invoice summary</h2>
        <div class="summary">
          <div class="scard"><div class="lab">Labor billed</div><div class="v" id="s-labor">$0</div></div>
          <div class="scard"><div class="lab">Parts billed</div><div class="v" id="s-parts">$0</div></div>
          <div class="scard big"><div class="lab">Invoice total</div><div class="v" id="s-total">$0</div></div>
          <div class="scard big"><div class="lab">vs. fair estimate</div><div class="v" id="s-var">$0</div></div>
        </div>
        <div class="placeholder-note" id="parts-placeholder">
          Parts are graded against the real Carrier &amp; Thermo King 2026 list (USD). This mockup uses a sample of part rows; the live tool indexes the full ~35,000-row combined list and matches by part number. Use the currency toggle if the invoice is in CAD.
        </div>
      </div>

      <!-- CHAT -->
      <div class="panel" style="margin-top:18px">
        <h2><span class="num">?</span> Ask about this invoice</h2>
        <div class="chat-seed">Try: <b class="seed">Should I dispute anything?</b> · <b class="seed">Is the compressor labor reasonable?</b> · <b class="seed">What should I ask the dealer?</b></div>
        <div id="chat-log" class="chat-log"></div>
        <div class="chat-input">
          <input id="chat-text" class="txt" placeholder="Ask a question about this repair invoice…">
          <button class="btn" id="chat-send">Send</button>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
/* ---------- SRT lookup (subset of real 62-10069 Rev B data) ---------- */
const SRT = {
  vector:{
    "compressor r&r":{code:"C1-A",hrs:4.0},
    "compressor":{code:"C1-A",hrs:4.0},
    "evacuate":{code:"R44-A",hrs:1.0},
    "charge":{code:"R44-A",hrs:1.0},
    "filter drier":{code:"R11-A",hrs:0.25},
    "drier":{code:"R11-A",hrs:0.25},
    "condenser motor":{code:"D4-A",hrs:0.75},
    "evaporator motor":{code:"D4-B",hrs:1.5},
    "evaporator coil":{code:"R21-A",hrs:9.6},
    "condenser coil":{code:"R1-A",hrs:4.0},
    "fan blade":{code:"D3-A",hrs:1.3},
    "bulkhead":{code:"A7-A",hrs:0.4},
    "high pressure switch":{code:"R10-A",hrs:0.8},
    "txv":{code:"R23-C",hrs:1.8},
  },
  x4:{
    "compressor":{code:"C1-A",hrs:4.0},
    "evacuate":{code:"R44-A",hrs:1.0},
    "charge":{code:"R44-A",hrs:1.0},
    "filter drier":{code:"R11-A",hrs:0.25},
    "drier":{code:"R11-A",hrs:0.25},
    "condenser coil":{code:"R1-A",hrs:4.0},
    "evaporator coil":{code:"R21-A",hrs:9.6},
    "receiver tank":{code:"R7-A",hrs:1.7},
    "evxv":{code:"R23-F",hrs:1.8},
  },
  x2:{
    "compressor":{code:"C1-A",hrs:4.0},
    "evacuate":{code:"R44-A",hrs:1.0},
    "filter drier":{code:"R11-A",hrs:0.25},
    "condenser coil":{code:"R1-A",hrs:4.0},
    "evaporator coil":{code:"R21-A",hrs:9.6},
    "txv":{code:"R23-C",hrs:1.8},
  }
};
/* Manufacturer LIST prices in USD (Carrier "Each Price" / TK "Crown" column).
   Sample rows from the real 2026 combined list; live tool indexes the full ~35k-row file by part #. */
const PARTS_LIST = {           // fallback by job code (USD)
  "C1-A":2988.10, "R44-A":0, "R11-A":48.85, "D4-A":298, "D4-B":340,
  "R21-A":2152.51, "R1-A":1359.47, "D3-A":190, "R10-A":85, "R23-C":210, "R7-A":260, "R23-F":420
};
/* BASIC factory warranty per family (from the TransX warranty matrices). months / hours; null = unlimited */
const WARRANTY = {
  vector:{months:36, hours:6000, label:"Vector 8600/8611 basic"},
  x4:{months:12, hours:null, label:"X4 7300/7500 basic"},
  x2:{months:12, hours:null, label:"X2 APX basic (inferred)"},
};
/* currency — list & AVRO prices are USD; the invoice may be USD or CAD */
let CUR="USD", FX=1.37;        // CAD per USD
/* AVRO aftermarket catalog (real products from avroparts.com). Prices are CAD. */
const AVRO = [
  {kw:"condenser coil", name:"Carrier Transicold 08-00330-00 Condenser Coil (X4)", price:1599.00,
   url:"https://www.avroparts.com/products/in-testing-verification-coming-soon-carrier-transicold-08-00330-00-condenser-coil-carrier-transicold-x4"},
