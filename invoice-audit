const WARRANTABLE = new Set(["C1-A","C10-A","C10-B","R1-A","R21-A","R22-A"]);

/* ---------- demo invoice prefilled (real Carrier part #s + USD list) ---------- */
const DEMO = [
  {item:"Compressor R&R", pn:"18-10143-21", code:"C1-A", srt:4.0, billed:6.5, parts:3250, list:2988.10},
  {item:"Evacuate & charge system", code:"R44-A", srt:1.0, billed:1.5, parts:0, list:0},
