/* ---------- chat (asks Claude about the current invoice) ---------- */
const chatHist=[];
function addMsg(role,text){const d=document.createElement("div");d.className="cmsg "+role;d.textContent=text;
  $("#chat-log").appendChild(d);$("#chat-log").scrollTop=1e6;return d;}
function buildContext(){
  const rate=+$("#rate").value||0;
  let s=`Current invoice analysis — unit family ${$("#unit").value}, currency ${CUR}, labor rate ${money(rate)}/hr.\nLine items:\n`;
  lines.forEach(l=>{ s+=`• ${l.item} [${l.code}] — SRT ${l.srt}h, billed ${l.billed==null?'?':l.billed}h, parts ${money(l.parts)}\n`; });
  s+=`Labor is ${$("#labor-val").textContent}× Standard Repair Time (${$("#labor-tag").textContent}). `;
  s+=`Parts are ${$("#parts-val").textContent}× OEM List Price (${$("#parts-tag").textContent}). `;
  s+=`Warranty status: ${$("#wst").textContent} (${$("#wsub").textContent}).`;
  return s;
}
async function sendChat(){
  const t=$("#chat-text").value.trim(); if(!t) return;
  $("#chat-text").value=""; addMsg("user",t);
  const think=addMsg("bot","thinking…"); think.classList.add("think");
  const userMsg = buildContext()+"\n\nOperator question: "+t;
  try{
    const res=await fetch("https://api.anthropic.com/v1/messages",{
      method:"POST", headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        model:"claude-sonnet-4-20250514", max_tokens:1000,
        system:"You are a transport-refrigeration service advisor helping a fleet operator audit a repair invoice for Carrier Transicold / Thermo King reefer units. Be concise, plain-spoken, and practical. Ground every answer in the invoice context provided. Don't invent SRT codes, part numbers, or prices that aren't in the context. When something looks high, say so and suggest what to ask the service provider.",
        messages:[...chatHist,{role:"user",content:userMsg}]
      })
    });
    const data=await res.json();
    const txt=(data.content||[]).filter(b=>b.type==="text").map(b=>b.text).join("\n").trim();
    think.remove(); addMsg("bot",txt||"(no response)");
    chatHist.push({role:"user",content:userMsg},{role:"assistant",content:txt});
  }catch(e){
    think.remove();
    addMsg("bot","Couldn't reach Claude from here. Inside Claude.ai this works automatically; on the live site it needs an API key via a small backend proxy (we'll wire that when you deploy).");
  }
}
$("#chat-send").addEventListener("click",sendChat);
$("#chat-text").addEventListener("keydown",e=>{ if(e.key==="Enter") sendChat(); });
