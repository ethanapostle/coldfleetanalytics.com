];

let lines = [];           // current parsed lines
let laborFactor = 1.40;   // draggable benchmark

const $ = s=>document.querySelector(s);
const cym = ()=> CUR==="CAD" ? "CA$" : "$";
const money = n=>cym()+Math.round(n).toLocaleString();
const usdToInv = u => u*(CUR==="CAD"?FX:1);     // OEM list/parts files are USD
const cadToInv = c => CUR==="CAD"? c : c/FX;    // AVRO prices are CAD

/* ---------- naive parser: match keywords -> SRT codes ---------- */
function parse(text, unit){
  const tbl = SRT[unit];
  const out = [];
  text.split(/\n/).forEach(raw=>{
    const ln = raw.trim(); if(!ln) return;
    const low = ln.toLowerCase();
    let match=null, key=null;
    for(const k in tbl){ if(low.includes(k)){ if(!match||k.length>key.length){match=tbl[k];key=k;} } }
    if(!match) return;
    const hr = (low.match(/([\d.]+)\s*hr/)||[])[1];
    const pr = (ln.match(/\$\s*([\d,]+)/g)||[]).map(s=>+s.replace(/[$,]/g,''));
    // assume largest $ figure on a line is parts
    out.push({item:ln.replace(/\.{2,}/g,' ').slice(0,60), code:match.code, srt:match.hrs,
      billed: hr?+hr:null, parts: pr.length?Math.max(...pr):0});
  });
  return out;
}

/* ---------- render table ---------- */
function renderTable(){
  const rate = +$("#rate").value||0;
  const body = $("#srt-body"); body.innerHTML="";
  let tsrt=0, tbill=0, tcost=0;
  lines.forEach((l,i)=>{
    tsrt+=l.srt; tcost+=l.srt*rate; if(l.billed) tbill+=l.billed;
    const tr=document.createElement("tr");
    tr.innerHTML=`
      <td>${l.item}</td>
      <td><span class="code ${l.code?'':'nomatch'}">${l.code||'no match'}</span></td>
      <td class="n">${l.srt.toFixed(2)}</td>
      <td class="n"><input class="hr ${l.billed==null?'flag':''}" type="number" step="0.1"
           value="${l.billed==null?'':l.billed}" data-i="${i}" placeholder="?"></td>
      <td class="n">${money(l.srt*rate)}</td>`;
    body.appendChild(tr);
  });
  $("#t-srt").textContent=tsrt.toFixed(2);
  $("#t-billed").textContent=tbill.toFixed(2);
  $("#t-srtcost").textContent=money(tcost);
  body.querySelectorAll("input.hr").forEach(inp=>inp.addEventListener("input",e=>{
    lines[+e.target.dataset.i].billed = e.target.value===''?null:+e.target.value;
    e.target.classList.toggle('flag', e.target.value==='');
    recompute();
  }));
}

/* ---------- gauge drawing ---------- */
function polar(cx,cy,r,deg){const a=(deg-180)*Math.PI/180;return[cx+r*Math.cos(a),cy+r*Math.sin(a)];}
function arc(cx,cy,r,a0,a1){const[x0,y0]=polar(cx,cy,r,a0),[x1,y1]=polar(cx,cy,r,a1);
  const large=(a1-a0)>180?1:0;return`M${x0} ${y0} A${r} ${r} 0 ${large} 1 ${x1} ${y1}`;}

function drawGauge(svg, min, max, val, zones, draggable){
  const cx=130,cy=140,r=96;
  const t = (v)=>((v-min)/(max-min))*180;          // value -> degrees 0..180
  let h="";
  // colored zone bands
  zones.forEach(z=>{ h+=`<path d="${arc(cx,cy,r,t(z.a),t(z.b))}" stroke="${z.c}" stroke-width="13" fill="none" stroke-linecap="butt"/>`;});
  // ticks
  zones.forEach(z=>{[z.a,z.b].forEach(()=>{});});
  // tick labels (min, important marks, max)
  const marks = svg.id==="g-labor" ? [1.0,1.1,1.4,1.7,2.0] : [0.8,1.0,1.2,1.4];
  marks.forEach(m=>{ if(m<min||m>max)return; const[x,y]=polar(cx,cy,r-22,t(m));
    h+=`<text x="${x}" y="${y+3}" fill="var(--txt-3)" font-size="9" font-family="var(--mono)" text-anchor="middle">${m.toFixed(svg.id==='g-labor'&&m%1?2:m%1?1:1).replace(/\.0$/,'.0')}</text>`;});
  // needle
  const deg=t(Math.max(min,Math.min(max,val)));
  const[nx,ny]=polar(cx,cy,r-4,deg);
  h+=`<line x1="${cx}" y1="${cy}" x2="${nx}" y2="${ny}" stroke="var(--txt)" stroke-width="3" stroke-linecap="round"/>`;
  h+=`<circle cx="${cx}" cy="${cy}" r="7" fill="var(--panel-2)" stroke="var(--txt)" stroke-width="2"/>`;
  if(draggable){const[hx,hy]=polar(cx,cy,r-4,deg);
    h+=`<circle class="needle" cx="${hx}" cy="${hy}" r="11" fill="var(--cyan)" opacity="0.95"/>`;
    h+=`<circle class="needle" cx="${hx}" cy="${hy}" r="22" fill="transparent"/>`;}
  svg.innerHTML=h;
}

/* zone configs */
const LABOR_ZONES=[
  {a:1.0,b:1.1,c:"#56d189"},  // great
  {a:1.1,b:1.7,c:"#e9a93f"},  // standard
  {a:1.7,b:2.0,c:"#e85a50"},  // high
];
const PARTS_ZONES=[
  {a:0.8,b:1.0,c:"#56d189"},  // below list = good
  {a:1.0,b:1.2,c:"#37d2c4"},  // 1.0-1.2 = great
  {a:1.2,b:1.5,c:"#e85a50"},  // high
];

function laborVerdict(f){
  if(f<=1.1) return ["Great","var(--green)"];
  if(f<1.7)  return ["Standard","var(--amber)"];
  return ["High","var(--red)"];
}
function partsVerdict(r){
  if(r<1.0)  return ["Good","var(--green)"];
  if(r<=1.2) return ["Great","var(--cyan)"];
  return ["High","var(--red)"];
}

/* ---------- recompute everything ---------- */
function recompute(){
  const rate=+$("#rate").value||0;
  renderTable();
  // labor
  let srtH=0, billH=0, billLabor=0;
  lines.forEach(l=>{ srtH+=l.srt; if(l.billed){billH+=l.billed; billLabor+=l.billed*rate;} });
  const actual = srtH? billH/srtH : 1;
  $("#labor-actual").textContent=actual.toFixed(2);
  // parts — list prices are USD, converted to the invoice currency for comparison
  let charged=0, list=0;
  lines.forEach(l=>{ charged+=l.parts; const lu=(l.list!=null?l.list:(PARTS_LIST[l.code]||0)); list+=usdToInv(lu); });
  const partsRatio = list? charged/list : 1;

  // gauges
  drawGauge($("#g-labor"),1.0,2.0,actual,LABOR_ZONES,true);
  drawGauge($("#g-parts"),0.8,1.5,partsRatio,PARTS_ZONES,false);

  // labor readout uses the draggable benchmark for "fair" calc, actual for verdict needle
  const[lt,lc]=laborVerdict(actual);
  $("#labor-val").textContent=actual.toFixed(2);
  $("#labor-tag").textContent=lt; $("#labor-tag").style.color=lc; $("#labor-tag").style.background=lc+"22";
  $("#labor-factor-echo").textContent=laborFactor.toFixed(2)+"×";
  $("#labor-fair").textContent=money(srtH*laborFactor*rate);

  const[pt,pc]=partsVerdict(partsRatio);
  $("#parts-val").textContent=partsRatio.toFixed(2);
  $("#parts-tag").textContent=pt; $("#parts-tag").style.color=pc; $("#parts-tag").style.background=pc+"22";
  $("#parts-charged").textContent=money(charged);
  $("#parts-list").textContent=money(list);
  $("#parts-over").textContent=money(charged-list);

  // summary
  const fairLabor = srtH*laborFactor*rate;
  const fairTotal = fairLabor + list*1.1; // fair parts ~ list+10%
  const invoiceTotal = billLabor + charged;
  $("#s-labor").textContent=money(billLabor);
  $("#s-parts").textContent=money(charged);
  $("#s-total").textContent=money(invoiceTotal);
  const variance = invoiceTotal - fairTotal;
  const vEl=$("#s-var");
  vEl.textContent=(variance>=0?"+":"−")+money(Math.abs(variance));
  vEl.className="v "+(variance>50?"neg":"pos");

  // ---- warranty & concession (BASIC factory warranty: months OR hours, whichever binds first) ----
  const unit=$("#unit").value, W=WARRANTY[unit];
  const uh=+$("#uhours").value||0;
  const isd=$("#isdate").value ? new Date($("#isdate").value) : null;
  const months = isd ? (Date.now()-isd.getTime())/(1000*60*60*24*30.44) : 0;
  const wmsgs=$("#wmsgs"), wbadge=$("#wbadge"), wst=$("#wst"), wsub=$("#wsub");
  // binding dimension = the one furthest along toward its limit
  const dims=[];
  if(W.months) dims.push({k:"month",val:months,lim:W.months,r:months/W.months,unit:"-month"});
  if(W.hours)  dims.push({k:"hour", val:uh,    lim:W.hours, r:uh/W.hours,   unit:"-hr"});
  dims.sort((a,b)=>b.r-a.r);
  const bind = dims[0] || {r:0,k:"",lim:0,unit:""};
  const limTxt = b=> `${b.lim.toLocaleString()}${b.unit} limit`;
  let coveredVal=0; const coveredNames=[];
  lines.forEach(l=>{ if(WARRANTABLE.has(l.code)){ coveredVal+=(l.billed?l.billed*rate:0)+l.parts; coveredNames.push(l.item.split(/ R&R| -/)[0].trim()); }});
  const cn = coveredNames.join(", ");
  const hrsTxt = W.hours ? `${uh.toLocaleString()}/${W.hours.toLocaleString()} hrs` : `${Math.round(months)}/${W.months} mo`;
  if(bind.r<=1.0){
    wst.textContent="Under warranty"; wst.style.color="var(--green)"; wbadge.style.background="rgba(86,209,137,.12)";
    wsub.textContent=hrsTxt;
    wmsgs.innerHTML = coveredVal>0
      ? `<div class="wmsg flag"><span class="i">⛔</span><div><b>Billed — but should be warranty.</b> ${cn} ${coveredNames.length>1?"are":"is"} still inside the ${W.label} (${limTxt(bind)}). <b>${money(coveredVal)}</b> should not have been charged — dispute these lines.</div></div>`
      : `<div class="wmsg ok"><span class="i">✅</span><div>Unit is inside the ${W.label}; no covered major components were billed on this invoice.</div></div>`;
  } else if(bind.r<=1.15){
    const over = bind.val - bind.lim, pct=(bind.r-1)*100;
    wst.textContent="Concession zone"; wst.style.color="var(--amber)"; wbadge.style.background="rgba(233,169,63,.12)";
    wsub.textContent=`${pct.toFixed(1)}% past limit`;
    wmsgs.innerHTML = `<div class="wmsg conc"><span class="i">⚠️</span><div><b>Ask for a concession.</b> The unit is ${Math.round(over).toLocaleString()}${bind.unit} (${pct.toFixed(1)}%) past the ${limTxt(bind)} — inside the 15% concession range.${coveredVal>0?` Covered repairs (${cn}) total <b>${money(coveredVal)}</b>. `:" "}Contact the dealer/manufacturer to request goodwill coverage before paying in full.</div></div>`;
  } else {
    wst.textContent="Out of warranty"; wst.style.color="var(--txt-2)"; wbadge.style.background="var(--panel-2)";
    wsub.textContent=`${(bind.r*100-100).toFixed(0)}% past limit`;
    wmsgs.innerHTML = `<div class="wmsg ok"><span class="i">ℹ️</span><div>Unit is past the ${W.label} (${limTxt(bind)}) by more than 15% — beyond the concession range under basic coverage.</div></div>`;
  }
  // standing advisement: basic warranty only; extended packages may apply (advice, no action)
  wmsgs.innerHTML += `<div class="wmsg ok" style="margin-top:8px"><span class="i">💡</span><div>This grades against <b>basic factory coverage</b> only — the most common. Major components carry longer terms (engine/compressor up to 48 mo/8,000 hrs; microprocessor up to 60 mo/10,000 hrs), and some TransX 2021 X4 units carry EMCC coverage (72 mo / 12,000 hrs). <b>Check the unit's serial plate or purchase records</b> — you may have bought a longer package before assuming a repair is out of warranty.</div></div>`;

  // ---- AVRO cost-saving opportunities (AVRO prices are CAD -> invoice currency) ----
  let sTot=0, sHtml="";
  lines.forEach(l=>{
    const low=l.item.toLowerCase();
    const m=AVRO.find(a=>low.includes(a.kw));
    const avroInv = m ? cadToInv(m.price) : 0;
    if(m && l.parts>avroInv){
      const sv=l.parts-avroInv; sTot+=sv;
      sHtml+=`<div class="sopp"><div class="body"><b>${l.item}</b><p>Charged ${money(l.parts)} · AVRO: ${m.name} — ${money(avroInv)}</p></div><div class="save">save ${money(sv)}</div><a href="${m.url}" target="_blank" rel="noopener">View on AVRO →</a></div>`;
    }
  });
  if(sHtml){ $("#savings-list").innerHTML=sHtml; $("#savings-tot").textContent="up to "+money(sTot); $("#savings-panel").style.display="block"; }
  else $("#savings-panel").style.display="none";

  // banner
  const b=$("#banner"), bh=$("#banner-h"), bp=$("#banner-p");
  if(actual>=1.7 || partsRatio>1.2){
    b.style.borderLeftColor="var(--red)"; b.querySelector(".em").textContent="⛔";
    bh.textContent="Overcharged"; bh.style.color="var(--red)";
    bp.textContent=`Labor is running ${actual.toFixed(2)}× SRT and/or parts are ${partsRatio.toFixed(2)}× list — both above fair-market range.`;
  } else if(actual>1.5 || partsRatio>1.1){
    b.style.borderLeftColor="var(--amber)"; b.querySelector(".em").textContent="⚠️";
    bh.textContent="Slightly high"; bh.style.color="var(--amber)";
    bp.textContent=`Within tolerance but on the high side. Labor ${actual.toFixed(2)}× SRT, parts ${partsRatio.toFixed(2)}× list.`;
  } else {
    b.style.borderLeftColor="var(--green)"; b.querySelector(".em").textContent="✅";
    bh.textContent="Fairly priced"; bh.style.color="var(--green)";
    bp.textContent=`Labor ${actual.toFixed(2)}× SRT and parts ${partsRatio.toFixed(2)}× list — both inside the fair-market range.`;
  }
}

/* ---------- labor gauge drag ---------- */
function enableDrag(){
  const svg=$("#g-labor"); let dragging=false;
  function setFromEvent(e){
    const rect=svg.getBoundingClientRect();
    const px=(e.touches?e.touches[0].clientX:e.clientX)-rect.left;
    const py=(e.touches?e.touches[0].clientY:e.clientY)-rect.top;
    // map to viewBox coords
    const vx=px/rect.width*260, vy=py/rect.height*168;
    let ang=Math.atan2(vy-140, vx-130)*180/Math.PI; // -180..0 over top half
    let deg=ang+180; deg=Math.max(0,Math.min(180,deg));
    laborFactor = 1.0 + deg/180*1.0;                 // map 0..180 -> 1.0..2.0
    laborFactor = Math.round(laborFactor*100)/100;
    recompute();
  }
  const down=e=>{dragging=true;svg.classList.add("drag");setFromEvent(e);e.preventDefault();};
  const move=e=>{if(dragging)setFromEvent(e);};
  const up=()=>{dragging=false;svg.classList.remove("drag");};
  svg.addEventListener("mousedown",down); svg.addEventListener("touchstart",down,{passive:false});
  window.addEventListener("mousemove",move); window.addEventListener("touchmove",move,{passive:false});
  window.addEventListener("mouseup",up); window.addEventListener("touchend",up);
}
